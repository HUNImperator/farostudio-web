# FARO – farostudio.hu, a weboldal gyökere

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /regi.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Egységes cím: https://farostudio.hu (www nélkül, mindig https)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Oldaltérkép a keresőknek
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Nem létező cím: a régi (WordPress) oldal címeinek átirányítása, különben 404-es oldal
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ regi.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Tömörítés és gyorsítótár (a CSS/JS fájlok verziószámmal frissülnek)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
